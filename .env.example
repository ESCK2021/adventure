# GitHub MCP (fine-grained PAT)
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=ESCK2021
GITHUB_REPO=adventure

# Supabase — https://supabase.com/dashboard
# Access Token: Account → Access Tokens
# Project ref: Project Settings → General → Reference ID
# API keys: Project Settings → API
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel — https://vercel.com/account/settings/tokens
# SCOPE: CLI team slug (auto-detected). ORG_ID: team_* id for GitHub CI (auto-written).
VERCEL_TOKEN=
VERCEL_SCOPE=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Sentry (optional until monitoring is wired)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
